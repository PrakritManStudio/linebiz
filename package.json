{
  "name": "@prakrit_m/linebiz",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for LINE OA web APIs (chat.line.biz)",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier -w .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "keywords": [
    "line",
    "line oa",
    "line official account",
    "chat.line.biz",
    "sdk",
    "typescript",
    "unofficial"
  ],
  "author": "Prakrit M.",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrakritManStudio/linebiz.git"
  },
  "bugs": {
    "url": "https://github.com/PrakritManStudio/linebiz/issues"
  },
  "homepage": "https://github.com/PrakritManStudio/linebiz#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@line/bot-sdk": "^11.4.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "~0.23.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types/index.js",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@line/bot-sdk": "11.4.0"
  }
}
